# Copy to .env and fill in any API keys needed by your sources.
# Values here are substituted into `${VAR}` placeholders in config.yaml.

# Private 404 Media feed key (`url: ...?key=${MEDIA_404_KEY}` in config.yaml).
MEDIA_404_KEY=your-key-here

# OpenAI API key — required for AI newsworthiness scoring + summaries
# (scoring.py). Without it the pipeline still runs but leaves scores/summaries
# blank. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-key-here
